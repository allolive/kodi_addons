From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: allolive <160342668+allolive@users.noreply.github.com>
Date: Tue, 29 Sep 2026 11:54:13 -0400
Subject: [PATCH 2/2] artwork: fall back to the movie's original language

After the user's language and English, prefer images in the language the
movie was made in before taking any image at all, and never list the
same image twice.
---
 python/lib/tmdbscraper/tmdb.py | 31 +++++++++++++++++++------------
 1 file changed, 19 insertions(+), 12 deletions(-)

diff --git a/python/lib/tmdbscraper/tmdb.py b/python/lib/tmdbscraper/tmdb.py
index 9e30424..f31b4ab 100644
--- a/python/lib/tmdbscraper/tmdb.py
+++ b/python/lib/tmdbscraper/tmdb.py
@@ -188,6 +188,7 @@ def _parse_artwork(movie, collection, urlbases, language):
     if language:
         # Image languages don't have regional variants
         language = language.split('-')[0]
+    original_language = movie.get('original_language') if movie else None
     posters = []
     landscape = []
     logos = []
@@ -195,9 +196,9 @@ def _parse_artwork(movie, collection, urlbases, language):
     keyart = []
 
     if 'images' in movie:
-        posters = _build_image_list_with_fallback(movie['images'].get('posters', []), urlbases, language)
-        landscape = _build_image_list_with_fallback(movie['images'].get('backdrops', []), urlbases, language)
-        logos = _build_image_list_with_fallback(movie['images'].get('logos', []), urlbases, language)
+        posters = _build_image_list_with_fallback(movie['images'].get('posters', []), urlbases, language, original_language=original_language)
+        landscape = _build_image_list_with_fallback(movie['images'].get('backdrops', []), urlbases, language, original_language=original_language)
+        logos = _build_image_list_with_fallback(movie['images'].get('logos', []), urlbases, language, original_language=original_language)
         fanart = _build_list_without_titles(movie['images'].get('backdrops', []), urlbases)
         keyart = _build_list_without_titles(movie['images'].get('posters', []), urlbases)
 
@@ -215,17 +216,23 @@ def _parse_artwork(movie, collection, urlbases, language):
         'set.poster': setposters, 'set.landscape': setlandscape, 'set.fanart': setfanart,
         'clearlogo': logos, 'keyart': keyart, 'set.keyart': setkeyart}
 
-def _build_image_list_with_fallback(imagelist, urlbases, language, language_fallback='en'):
-    images = _build_image_list(imagelist, urlbases, [language])
-
-    # Add backup images
-    if language != language_fallback:
-        images.extend(_build_image_list(imagelist, urlbases, [language_fallback]))
-
-    # Add any images if nothing set so far
+def _build_image_list_with_fallback(imagelist, urlbases, language, language_fallback='en', original_language=None):
+    # Preference order: user's language, English fallback, original movie language, anything.
+    images = []
+    seen = set()
+    def add_for(lang):
+        for img in _build_image_list(imagelist, urlbases, [lang]):
+            if img['url'] not in seen:
+                seen.add(img['url'])
+                images.append(img)
+    if language:
+        add_for(language)
+    if language_fallback != language:
+        add_for(language_fallback)
+    if original_language and original_language != language and original_language != language_fallback:
+        add_for(original_language)
     if not images:
         images = _build_image_list(imagelist, urlbases)
-
     return images
 
 def _build_list_without_titles(imagelist, urlbases):

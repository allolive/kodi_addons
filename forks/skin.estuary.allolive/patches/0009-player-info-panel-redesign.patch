 				<bordersize>20</bordersize>
 				<include>OpenClose_Left</include>
 			</control>
+			<!-- MIDDLE COLUMN: title / facts / rating / tags / plot.
+			     Wider now that the credits column is narrower. -->
 			<control type="grouplist">
 				<left>420</left>
-				<top>10</top>
-				<right>20</right>
-				<height>300</height>
+				<top>40</top>
+				<right>460</right>
+				<height>440</height>
 				<align>left</align>
 				<orientation>vertical</orientation>
 				<itemgap>10</itemgap>
+				<!-- TV eyebrow: Show • S<n>E<n> -->
+				<control type="label">
+					<height>22</height>
+					<font>font12</font>
+					<textcolor>grey</textcolor>
+					<label>$INFO[VideoPlayer.TVShowTitle]$INFO[VideoPlayer.Season, • S]$INFO[VideoPlayer.Episode,E]</label>
+					<visible>!String.IsEmpty(VideoPlayer.TVShowTitle)</visible>
+				</control>
+				<!-- Title — textbox so long titles wrap to a second line
+				     instead of getting truncated. Two-line cap. -->
 				<control type="textbox">
-					<height>294</height>
-					<label fallback="10005">$INFO[VideoPlayer.Tagline,[B],[/B][CR]]$INFO[VideoPlayer.Plot]</label>
+					<height>72</height>
+					<font>font13_title</font>
+					<textcolor>white</textcolor>
+					<align>left</align>
+					<label>$INFO[VideoPlayer.Title]</label>
+				</control>
+				<!-- Facts: year • mpaa • genre (Duration dropped — seek bar
+				     directly below already shows position/runtime). -->
+				<control type="label">
+					<height>22</height>
+					<font>font12</font>
+					<textcolor>white</textcolor>
+					<label>$INFO[VideoPlayer.Year]$INFO[VideoPlayer.mpaa, • ]$INFO[VideoPlayer.Genre, • ]</label>
+				</control>
+				<!-- Numeric rating with star glyph (U+2605). -->
+				<control type="label">
+					<height>22</height>
+					<font>font12</font>
+					<textcolor>white</textcolor>
+					<label>&#9733; $INFO[VideoPlayer.Rating]$INFO[VideoPlayer.Votes, [COLOR grey]( ,)[/COLOR]]</label>
+					<visible>!String.IsEmpty(VideoPlayer.Rating)</visible>
+				</control>
+				<!-- Tags row. VideoPlayer.Tags doesn't exist as an info-label;
+				     the singular ListItem.Tag is what Kodi exposes (joined
+				     with the videoItemSeparator from advancedsettings). It
+				     resolves the playing item's tags during fullscreen video
+				     because the player publishes that as the active ListItem. -->
+				<control type="textbox">
+					<height>44</height>
+					<font>font12</font>
+					<textcolor>grey</textcolor>
+					<label>[UPPERCASE]$LOCALIZE[20459][/UPPERCASE]  $INFO[ListItem.Tag]</label>
+					<align>left</align>
+					<visible>!String.IsEmpty(ListItem.Tag)</visible>
+				</control>
+				<!-- Plot. Tagline rendered italic with a blank line above
+				     the body. font13 gives the description more visual weight.
+				     Height sized to fill the remaining vertical room in the
+				     panel so plots rarely need scrolling — autoscroll removed
+				     (Kodi has no skin-side way to reset its scroll position
+				     between dialog opens, so static is the cleaner UX). -->
+				<control type="textbox">
+					<height>340</height>
+					<label fallback="10005">$INFO[VideoPlayer.Tagline,[I],[/I][CR][CR]]$INFO[VideoPlayer.Plot]</label>
+					<font>font13</font>
+					<textcolor>white</textcolor>
 					<align>left</align>
-					<autoscroll delay="5000" repeat="7500" time="5000"></autoscroll>
 					<visible>Integer.IsGreaterOrEqual(Playlist.Position(video), Playlist.Length(video))</visible>
 				</control>
 				<control type="textbox">
-					<height>250</height>
-					<label fallback="10005">$INFO[VideoPlayer.Tagline,[B],[/B][CR]]$INFO[VideoPlayer.Plot]</label>
+					<height>310</height>
+					<label fallback="10005">$INFO[VideoPlayer.Tagline,[I],[/I][CR][CR]]$INFO[VideoPlayer.Plot]</label>
+					<font>font13</font>
+					<textcolor>white</textcolor>
 					<align>left</align>
-					<autoscroll delay="5000" repeat="7500" time="5000"></autoscroll>
 					<visible>Integer.IsLess(Playlist.Position(video), Playlist.Length(video))</visible>
 				</control>
+				<!-- Next-up label for playlist context. Stays in middle
+				     column at the bottom of the plot, where it makes
+				     contextual sense. -->
 				<control type="label">
-					<height>50</height>
+					<height>26</height>
+					<font>font12</font>
 					<label>$VAR[OSDNextLabelVar]</label>
 					<visible>Integer.IsLess(Playlist.Position(video), Playlist.Length(video))</visible>
 				</control>
 			</control>
+			<!-- RIGHT COLUMN: credits (director + cast). Kodi's Cast info-label
+			     is hard-coded newline-separated, so this is a tall narrow
+			     column. Width 400 fits typical "First Last" names on one
+			     line; longer names wrap automatically — that's the
+			     "responsive" behavior since skin XML has no String.Length
+			     for content-based sizing. -->
+			<control type="grouplist">
+				<left>1500</left>
+				<top>40</top>
+				<right>20</right>
+				<height>440</height>
+				<align>left</align>
+				<orientation>vertical</orientation>
+				<itemgap>14</itemgap>
+				<!-- DIRECTOR section -->
+				<control type="label">
+					<height>20</height>
+					<font>font12</font>
+					<textcolor>grey</textcolor>
+					<label>[UPPERCASE]$LOCALIZE[20339][/UPPERCASE]</label>
+					<visible>!String.IsEmpty(VideoPlayer.Director)</visible>
+				</control>
+				<control type="textbox">
+					<height>54</height>
+					<font>font12</font>
+					<textcolor>white</textcolor>
+					<label>$INFO[VideoPlayer.Director]</label>
+					<align>left</align>
+					<visible>!String.IsEmpty(VideoPlayer.Director)</visible>
+				</control>
+				<!-- CAST section — fills remaining vertical room. Autoscroll
+				     removed: Kodi has no skin-side way to reset scroll
+				     position between dialog opens. Long casts will clip
+				     at the bottom rather than cycle indefinitely. Tall
+				     height (340) makes that rare for most films. -->
+				<control type="label">
+					<height>20</height>
+					<font>font12</font>
+					<textcolor>grey</textcolor>
+					<label>[UPPERCASE]$LOCALIZE[206][/UPPERCASE]</label>
+					<visible>!String.IsEmpty(VideoPlayer.Cast)</visible>
+				</control>
+				<control type="textbox">
+					<height>340</height>
+					<font>font12</font>
+					<textcolor>white</textcolor>
+					<label>$INFO[VideoPlayer.Cast]</label>
+					<align>left</align>
+					<visible>!String.IsEmpty(VideoPlayer.Cast)</visible>
+				</control>
+			</control>
 		</control>
 	</controls>
 </window>
diff --git a/xml/Includes.xml b/xml/Includes.xml
index 66cfb82..0e188c9 100644
--- a/xml/Includes.xml

+# -*- coding: utf-8 -*-
+"""
+ppi_sysfs.py - publish Amlogic Dolby Vision / HDR / output sysfs readouts as
+Home-window properties for the (CPM-style) DialogPlayerProcessInfo screen.
+
+No Kodi engine changes. The standard rich data (decoder, deinterlace, codec,
+resolution, fps, bitrate, amlogic.displaymode / eoft_gamut / pixformat, ...)
+already comes from Kodi infolabels and is used directly by the skin. This script
+only adds the extra fields that the Amlogic driver exposes in sysfs but no Kodi
+infolabel does:
+
+    Window(Home).Property(ppi.source_format)   true source HDR format ("Dolby Vision")
+    Window(Home).Property(ppi.graphic_format)  graphic-plane format ("SDR")
+    Window(Home).Property(ppi.dv_provider)     raw provider string
+    Window(Home).Property(ppi.dv_mode)         DV output mode ("IPT Tunnel", "HDR10", ...)
+    Window(Home).Property(ppi.process)         tone-map path ("HDR10 -> IPT")
+    Window(Home).Property(ppi.out_mode)        HDMI output mode ("3840x2160p 24Hz")
+    Window(Home).Property(ppi.out_color)       HDMI colour ("8-bit RGB, full")
+    Window(Home).Property(ppi.out_eotf)        HDMI EOTF ("DV-Std")
+    Window(Home).Property(ppi.out_gamut)       HDMI colourimetry ("BT.2020nc")
+    Window(Home).Property(ppi.out_hdr)         HDMI HDR status ("DolbyVision-Std")
+
+The live DV L1/L5/L6 nits & PQ and MaxCLL/FALL live in the DV RPU, which only the
+C++ decoder sees (dv_pq_info / probe_data read back empty on a stock build), so
+the skin omits those rows.
+
+The OSD "PPI" button toggles Skin.HasSetting(ppiscreen) (atomic) and then runs
+this script. While that setting is on and video is playing the poller stays
+alive, but it only reads sysfs / refreshes the properties while the overlay is
+actually on screen (i.e. the OSD is up); when the OSD is hidden it idles, and
+when PPI is toggled off (or playback stops) it cleans up. The overlay lives in
+VideoOSD.xml so the OSD keeps input focus (you can still move the button
+selection and click PPI again to toggle off).
+"""
+import os
+import re
+
+import xbmc
+import xbmcgui
+
+HOME = xbmcgui.Window(10000)
+SETTING = "ppiscreen"
+LOCK = "ppi.sysfs.running"
+POLL_SECONDS = 1
+
+DV = "/sys/class/amdolby_vision/"
+VIDEO = "/sys/class/video/"
+HDMI = "/sys/class/amhdmitx/amhdmitx0/"
+
+# raw source-format token -> friendly label
+_FMT = {
+    "DOVI": "Dolby Vision",
+    "HDR10": "HDR10",
+    "HDR10PLUS": "HDR10+",
+    "HLG": "HLG",
+    "SDR": "SDR",
+    "PRIMESL": "Prime SL",
+    "CUVA": "CUVA",
+}
+
+# raw DV output-mode token -> friendly label
+_DVMODE = {
+    "BYPASS": "Bypass",
+    "IPT": "IPT",
+    "IPT_TUNNEL": "IPT Tunnel",
+    "HDR10": "HDR10",
+    "SDR10": "SDR (10-bit)",
+    "SDR8": "SDR (8-bit)",
+}
+
+# every property this script owns (so we can clear them all on exit)
+_PROPS = (
+    "ppi.graphic_format", "ppi.dv_provider",
+    "ppi.dv_mode", "ppi.process",
+    "ppi.out_mode", "ppi.out_color", "ppi.out_eotf", "ppi.out_gamut", "ppi.out_hdr",
+    # CPU load: Kodi's main/render thread (as % of one core) + system average.
+    "ppi.kodi_cpu", "ppi.cpu_avg",
+)
+
+
+def _read(base, path):
+    try:
+        with open(base + path, "r") as f:
+            return f.read().strip()
+    except Exception:
+        return ""
+
+
+def _fmt_label(token):
+    return _FMT.get(token.upper(), token) if token else ""
+
+
+def _pretty_mode(token):
+    # "3840x2160p24hz" -> "3840x2160p 24Hz"
+    m = re.match(r"(\d+x\d+[pi])(\d+)hz", token, re.I)
+    return "%s %sHz" % (m.group(1), m.group(2)) if m else token
+
+
+# --- CPU load -------------------------------------------------------------
+# System.CpuUsage only exposes per-core figures, which hide a single thread
+# saturating one core: the scheduler migrates that thread across cores, so each
+# core reads low even though one core's worth of compute is being burned. We
+# read /proc directly to report Kodi's main/render thread (the busy one) as a
+# percentage of one core, plus the true system-wide average across all cores.
+_PID = os.getpid()
+_NCPU = os.cpu_count() or 1
+_cpu_prev = {}  # carries the previous sample between polls
+
+
+def _main_thread_jiffies():
+    # /proc/<pid>/task/<pid>/stat -> utime (14) + stime (15), 1-indexed. comm
+    # (field 2) can contain spaces/parens, so split after the last ')'.
+    try:
+        with open("/proc/%d/task/%d/stat" % (_PID, _PID)) as f:
+            rest = f.read().rpartition(")")[2].split()
+        return int(rest[11]) + int(rest[12])
+    except Exception:
+        return None
+
+
+def _system_jiffies():
+    # /proc/stat "cpu" line: user nice system idle iowait irq softirq steal ...
+    try:
+        with open("/proc/stat") as f:
+            v = [int(x) for x in f.readline().split()[1:]]
+        idle = v[3] + (v[4] if len(v) > 4 else 0)  # idle + iowait
+        total = sum(v)
+        return total - idle, total
+    except Exception:
+        return None, None
+
+
+def cpu_usage():
+    """(kodi_main_thread % of one core, system average %) as label strings."""
+    main = _main_thread_jiffies()
+    busy, total = _system_jiffies()
+    res = ("", "")
+    if (main is not None and busy is not None and _cpu_prev
+            and total > _cpu_prev["total"]):
+        dt = total - _cpu_prev["total"]
+        # plain integers (no %): drive the skin progress bars; the skin label
+        # appends the % sign for display.
+        res = ("%.0f" % ((main - _cpu_prev["main"]) / (dt / _NCPU) * 100.0),
+               "%.0f" % ((busy - _cpu_prev["busy"]) / dt * 100.0))
+    if main is not None and busy is not None:
+        _cpu_prev.update(main=main, busy=busy, total=total)
+    return res
+
+
+def collect():
+    """Return {property: value} from the current sysfs state."""
+    out = {p: "" for p in _PROPS}
+
+    # --- graphic format / output-only sysfs reads ------------------------
+    # NOTE: the source HDR type is NOT read here - the skin takes it straight
+    # from Kodi's VideoPlayer.HdrType (the one authority for the file format).
+    # amdolby_vision only knows the DV *output*, which is the wrong thing for a
+    # converted HDR10+ stream. These reads feed dv_mode / process / graphic only.
+    proc_m = re.search(r"src_fmt\s*=\s*(\S+);\s*out_fmt\s*=\s*(\S+)",
+                       _read(VIDEO, "process_fmt"))  # "src_fmt = HDR10; out_fmt = HDR10"
+
+    dv = _read(DV, "src_format")  # "vd1(inst0): NONE FORMAT_DOVI\ngraphic: FORMAT_SDR"
+    dv_m = re.search(r"FORMAT_([A-Z0-9]+)", dv.splitlines()[0]) if dv else None
+    dv_fmt = dv_m.group(1).upper() if dv_m else ""
+
+    gfx = re.search(r"graphic:\s*FORMAT_([A-Z0-9]+)", dv)
+    if gfx:
+        out["ppi.graphic_format"] = _fmt_label(gfx.group(1))
+    if not out["ppi.graphic_format"]:
+        g = re.search(r"FORMAT_([A-Z0-9]+)", _read(DV, "graphic_fmt"))
+        if g:
+            out["ppi.graphic_format"] = _fmt_label(g.group(1))
+
+    # --- DV provider (raw list of registered providers, not active layers)
+    prov = _read(DV, "dv_provider")
+    if prov:
+        out["ppi.dv_provider"] = prov
+
+    # (DV layer detail - FEL/MEL - intentionally not shown: it isn't in sysfs
+    # and the active-core count can't distinguish them, so there's no clean
+    # source without a Kodi code change.)
+
+    # --- DV output mode: only when the source is actually Dolby Vision, so the
+    # line hides on HDR10/SDR (where the driver reports dv_mode "off").
+    if dv_fmt == "DOVI":
+        m = re.search(r"current dv_mode\s*=\s*(\S+)", _read(DV, "dv_mode"))
+        if m:
+            out["ppi.dv_mode"] = _DVMODE.get(m.group(1).upper(), m.group(1))
+
+    # --- tone-map path: "src_fmt = HDR10; out_fmt = IPT" -> "HDR10 -> IPT"
+    if proc_m:
+        out["ppi.process"] = "%s -> %s" % (proc_m.group(1), proc_m.group(2))
+
+    # (Live fps / frame-drop metrics were dropped: the video plane stops
+    # outputting while this dialog is up, so VF.fps / fps_info read 0 and any
+    # "render rate" / "dropped frames" shown here would be meaningless.)
+
+    # --- HDMI output: parse "Key: Value" lines from amhdmitx config
+    cfg = {}
+    for line in _read(HDMI, "config").splitlines():
+        if ":" in line:
+            k, _, v = line.partition(":")
+            cfg[k.strip().lower()] = v.strip()
+    vic = cfg.get("vic", "")
+    mv = re.search(r"(\d+x\d+[pi]?\d*hz)", vic, re.I)
+    if mv:
+        out["ppi.out_mode"] = _pretty_mode(mv.group(1))
+    depth = cfg.get("colour depth", "")
+    space = cfg.get("colourspace", "")
+    # Range depends on the active colourspace: YUV/YCC output carries its range on
+    # the "YCC colour range" line; the plain "colour range" line is the RGB range
+    # (reads "default" when output is YUV, so it's the wrong field there).
+    if space.upper().startswith(("YUV", "YCC", "YCBCR")):
+        rng = cfg.get("ycc colour range", "")
+    else:
+        rng = cfg.get("colour range", "")
+    color = " ".join(p for p in (depth, space) if p)
+    if rng:
+        color = ("%s, %s" % (color, rng)) if color else rng
+    out["ppi.out_color"] = color
+    out["ppi.out_eotf"] = cfg.get("eotf", "")
+    out["ppi.out_gamut"] = cfg.get("colourimetry", "")
+
+    hdr = _read(HDMI, "hdmi_hdr_status")
+    if hdr:
+        out["ppi.out_hdr"] = hdr
+
+    # --- CPU: Kodi main/render thread (% of one core) + system average
+    out["ppi.kodi_cpu"], out["ppi.cpu_avg"] = cpu_usage()
+
+    return out
+
+
+def main():
+    # The button already toggled Skin.HasSetting(ppiscreen). If it is now OFF,
+    # just make sure the published data is cleared and exit.
+    if not xbmc.getCondVisibility("Skin.HasSetting(%s)" % SETTING):
+        for prop in _PROPS:
+            HOME.clearProperty(prop)
+        return
+    # ON: poll while the setting stays on and video is playing (one poller only)
+    if HOME.getProperty(LOCK) == "1":
+        return
+    HOME.setProperty(LOCK, "1")
+    monitor = xbmc.Monitor()
+    last = {}
+    try:
+        while not monitor.abortRequested():
+            # Stay alive (so we survive the OSD opening/closing without needing a
+            # relaunch) until the PPI toggle is turned off or playback ends.
+            if not xbmc.getCondVisibility(
+                    "Skin.HasSetting(%s) + Player.HasVideo" % SETTING):
+                break
+            # Only read sysfs / publish while the overlay is actually on screen -
+            # no point polling when the OSD (and thus the panel) is hidden.
+            if xbmc.getCondVisibility(
+                    "Window.IsVisible(videoosd) + !Window.IsVisible(fullscreeninfo)"):
+                # Only push properties that actually changed, so the GUI thread
+                # isn't asked to re-evaluate labels every second for no reason.
+                for prop, val in collect().items():
+                    if last.get(prop) != val:
+                        HOME.setProperty(prop, val)
+                        last[prop] = val
+            if monitor.waitForAbort(POLL_SECONDS):
+                break
+    finally:
+        for prop in _PROPS:
+            HOME.clearProperty(prop)
+        HOME.clearProperty(LOCK)
+        # if playback ended while the overlay was on, switch it back off
+        if not xbmc.getCondVisibility("Player.HasVideo"):
+            xbmc.executebuiltin("Skin.Reset(%s)" % SETTING)
+
+
+if __name__ == "__main__":
+    main()

diff --git a/xml/Variables.xml b/xml/Variables.xml
index 12d2d33..fa71c1a 100644
--- a/xml/Variables.xml
+++ b/xml/Variables.xml
@@ -791,7 +791,11 @@
 		<value>$MAP[DefaultHdrMap, ListItem.HdrType]</value>
 	</variable>
 	<variable name="VideoHDRType1Var">

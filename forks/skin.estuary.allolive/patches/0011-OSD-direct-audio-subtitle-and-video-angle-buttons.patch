+		<value>$VAR[ActiveVideoPlayerAudioLanguage]</value>
+	</variable>
+	<variable name="OSDSubLangVar">
+		<value condition="!String.IsEmpty(Window(Home).Property(MediaInfo.Player.SubtitleLanguage))">$INFO[Window(Home).Property(MediaInfo.Player.SubtitleLanguage)]</value>
+		<value>$INFO[VideoPlayer.SubtitlesLanguage]</value>
+	</variable>

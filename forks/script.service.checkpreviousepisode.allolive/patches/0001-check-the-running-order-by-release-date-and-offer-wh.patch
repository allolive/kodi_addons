+    def ask(self, title, details, missed, absent):
+        """
+        Say what was skipped and ask what to do: 'watch' the first of it, 'play' this one now,
+        'ignore' the show from now on, or 'stop' - also what back does. Marking some as already
+        seen happens in here, and asks again about what is left. Returns the choice and what is
+        still missed.
+        """
+        playing = code(details)
+        while True:
+            if missed:
+                # nothing else to play when the episodes are only missing from the library
+                yes, no = ('watch', TRANSLATE(32026) % code(missed[0])), ('play', TRANSLATE(32027) % playing)
+            else:
+                yes, no = ('play', TRANSLATE(32031) % playing), ('stop', TRANSLATE(32021))
+            result = xbmcgui.Dialog().yesnocustom(TRANSLATE(32024) % title, self.message(details, missed, absent),
+                                                  TRANSLATE(32028), nolabel=no[1], yeslabel=yes[1],
+                                                  defaultbutton=xbmcgui.DLG_YESNO_YES_BTN)
+            if result != 2:
+                return {1: yes[0], 0: no[0]}.get(result, 'stop'), missed
+
+            more = ([('seen', TRANSLATE(32032))] if missed else []) + \
+                   [('ignore', TRANSLATE(32035) % title), ('stop', TRANSLATE(32021))]
+            picked = xbmcgui.Dialog().select(TRANSLATE(32024) % title, [text for _, text in more])
+            if picked < 0:
+                continue
+            if more[picked][0] != 'seen':
+                return more[picked][0], missed
+            ticked = set(xbmcgui.Dialog().multiselect(TRANSLATE(32033), [self.shown(e) for e in missed],
+                                                      preselect=list(range(len(missed)))) or [])
+            self.mark_watched([e for i, e in enumerate(missed) if i in ticked])
+            missed = [e for i, e in enumerate(missed) if i not in ticked]
+            if not missed and not absent:
+                return 'play', missed
+
+    @staticmethod
+    def mark_watched(episodes):
+        """One JSON-RPC batch, so ticking many is one round trip and one library update."""
+        if not episodes:
+            return
+        Logger.info(f"Marking watched: {[label(e) for e in episodes]}")
+        send_kodi_json("Mark episodes watched", json.dumps(
+                [{"jsonrpc":"2.0", "id":i, "method":"VideoLibrary.SetEpisodeDetails",
+                  "params":{"episodeid":e['episodeid'], "playcount":1}} for i, e in enumerate(episodes)]))
+
+    @staticmethod
+    def shown(episode):
+        """S04E06 The Stockiverse Ray, or for a special S00E04 Its Title (special, 2021)"""
+        text = '%s %s' % (code(episode), episode.get('title', ''))
+        date = aired(episode)
+        if episode['season'] == 0 and date:
+            text = TRANSLATE(32036) % (text, date.year)
+        return text
+
+    def message(self, details, missed, absent):
+        lines = []
+        if missed:
+            lines.append(TRANSLATE(32025) % ('%s "%s"' % (code(details), details.get('title', ''))))
+            lines += ['  \u2022 ' + self.shown(e) for e in missed[:LISTED]]
+            if len(missed) > LISTED:
+                lines.append('  ' + TRANSLATE(32030) % (len(missed) - LISTED))
+        if absent:
+            lines.append(TRANSLATE(32034) % ', '.join('S%02dE%02d' % n for n in absent))
+        return '[CR]'.join(lines)
+
+    def play_first(self, episode):
+        """Play the first missed episode instead, from its resume point if it was started."""
+        Logger.info(f"Playing {label(episode)} instead")
+        kodi("Play first missed episode", "Player.Open",
+             {"item":{"episodeid":episode['episodeid']}, "options":{"resume":True}})
+
+    def stop_and_browse(self, tvshowid, title, season):

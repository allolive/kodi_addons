index 0000000..7e458eb
--- /dev/null
+++ b/resources/lib/running_order.py
@@ -0,0 +1,130 @@
+"""
+A show's running order, specials included, and what was skipped on the way to an episode.
+
+Regular episodes run by season and episode number. A special goes where the scraper says it
+airs (Kodi's specialsortseason/specialsortepisode) or, when it does not say, after the last
+regular episode released on or before the special's own release date. A special with neither
+has no place in the order and is never checked or suggested.
+
+Kept free of Kodi imports so it can be tested on its own.
+"""
+import bisect
+import datetime
+from dataclasses import dataclass
+from typing import Dict, List, Optional, Tuple
+
+Episode = Dict
+
+# Kodi's specialsortepisode for "airs after season N" rather than before an episode of it
+AFTER_SEASON = 0x1000
+# what scrapers write when they have no date: the epoch, shown in either time zone
+NO_DATE = {'1969-12-31', '1970-01-01'}
+
+
+def aired(episode: Episode) -> Optional[datetime.date]:
+    text = (episode.get('firstaired') or '')[:10]
+    if text in NO_DATE:
+        return None
+    try:
+        return datetime.date.fromisoformat(text)
+    except ValueError:
+        return None
+
+
+def watched(episode: Episode) -> bool:
+    return (episode.get('playcount') or 0) > 0
+
+
+def code(episode: Episode) -> str:
+    return 'S%02dE%02d' % (episode['season'], episode['episode'])
+
+
+def _first(copies: List[Episode]) -> Episode:
+    """The copy that stands for the episode: one already watched, else the one started, else the first."""
+    return max(copies, key=lambda e: (watched(e), (e.get('resume') or {}).get('position') or 0,
+                                      -e['episodeid']))
+
+
+def running_order(episodes: List[Episode], specials: bool = True) -> List[List[Episode]]:
+    """The show's episodes in viewing order; each place holds every copy of that episode."""
+    copies: Dict[Tuple[int, int], List[Episode]] = {}
+    for episode in episodes:
+        copies.setdefault((episode['season'], episode['episode']), []).append(episode)
+    regular_keys = sorted(k for k in copies if k[0] > 0)
+    # each regular episode's release date, read once for every special placed by its own
+    dated = [(i, d) for i, k in enumerate(regular_keys) if (d := aired(_first(copies[k])))]
+
+    slots: Dict[int, List[Tuple[datetime.date, int]]] = {}
+    for key in sorted(k for k in copies if k[0] == 0) if specials else ():
+        special = _first(copies[key])
+        date = aired(special)
+        season = special.get('specialsortseason') or -1
+        if season > 0:
+            number = special.get('specialsortepisode') or -1
+            if number == AFTER_SEASON or number <= 0:
+                number = AFTER_SEASON + 1
+            slot = bisect.bisect_left(regular_keys, (season, number))
+        elif date and dated:
+            # after the last regular episode released on or before it
+            slot = max((i + 1 for i, d in dated if d <= date), default=0)
+        else:
+            continue
+        slots.setdefault(slot, []).append((date or datetime.date.min, key[1]))
+
+    order: List[List[Episode]] = []
+    for i in range(len(regular_keys) + 1):
+        order += [copies[(0, number)] for _, number in sorted(slots.get(i, []))]
+        if i < len(regular_keys):
+            order.append(copies[regular_keys[i]])
+    return order
+
+
+@dataclass
+class Gap:
+    """What was skipped on the way to the playing episode."""
+    # episodes in the library, not watched, in viewing order: the first is where to resume
+    missed: List[Episode]
+    # (season, episode) numbers before it in its season that are not in the library at all -
+    # upstream's own check, kept to the playing episode's season as it always was
+    absent: List[Tuple[int, int]]
+
+    def __bool__(self) -> bool:
+        return bool(self.missed or self.absent)
+
+
+def find_gap(episodes: List[Episode], playing_id: int, specials: bool = True,
+             absent: bool = True) -> Gap:
+    """
+    Every episode before the playing one that was not watched, from the show's first regular
+    episode on: specials released before it never stop a first episode.
+
+    Skips from long ago count too - most were never a choice, the special nobody said was
+    there. Marking them watched once settles them.
+    """
+    order = running_order(episodes, specials)
+    position = next((i for i, place in enumerate(order)
+                     if any(e['episodeid'] == playing_id for e in place)), None)
+    if position is None:
+        return Gap([], [])
+    playing = order[position][0]
+    start = next((i for i, place in enumerate(order) if place[0]['season'] > 0), position)
+    missed = [_first(place) for place in order[start:position]
+              if not any(watched(e) for e in place)]
+
+    gaps: List[Tuple[int, int]] = []
+    if absent and playing['season'] > 0:
+        present = {(e['season'], e['episode']) for e in episodes}
+        gaps = [(playing['season'], n) for n in range(1, playing['episode'])
+                if (playing['season'], n) not in present]
+    return Gap(missed, gaps)
+
+
+def label(episode: Episode) -> str:
+    """S00E03 "Heart of Archness (1)" (2011-09-15)"""
+    text = code(episode)
+    if episode.get('title'):
+        text += ' "%s"' % episode['title']
+    date = aired(episode)
+    if date:
+        text += ' (%s)' % date.isoformat()
+    return text

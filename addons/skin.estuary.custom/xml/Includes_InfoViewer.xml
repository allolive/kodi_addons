<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="InfoViewerLayout">
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>40%</centertop>
			<width>1400</width>
			<height>640</height>
			<animation type="Visible" reversible="false">
				<effect type="zoom" start="80" end="100" center="50%,50%" delay="160" tween="back" time="240"/>
				<effect type="fade" delay="160" end="100" time="240"/>
			</animation>
			<animation type="Visible" reversible="false">
				<effect type="zoom" start="100" end="80" center="50%,50%" easing="in" tween="back" time="240"/>
				<effect type="fade" start="100" end="0" time="240"/>
			</animation>
			<animation effect="fade" start="100" end="0" time="0">WindowClose</animation>
			<depth>DepthDialog</depth>
			<visible>!String.IsEmpty(Window(home).Property(InfoViewer_Visible))</visible>
			<control type="image">
				<left>-2000</left>
				<top>-2000</top>
				<width>6000</width>
				<height>6000</height>
				<animation effect="fade" time="300">VisibleChange</animation>
				<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
				<texture colordiffuse="80FFFFFF">colors/black.png</texture>
			</control>
			<control type="button">
				<left>-2000</left>
				<top>-2000</top>
				<width>6000</width>
				<height>6000</height>
				<texturefocus/>
				<texturenofocus/>
				<onclick>ClearProperty(InfoViewer_Visible,home)</onclick>
			</control>
			<control type="group">
				<width>1400</width>
				<height>640</height>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<height>70</height>
					<texture colordiffuse="dialog_header_tint">colors/white.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>70</top>
					<right>0</right>
					<bottom>0</bottom>
					<texture colordiffuse="dialog_tint">colors/white.png</texture>
				</control>
				<control type="label" id="1">
					<left>40</left>
					<top>0</top>
					<right>100</right>
					<height>70</height>
					<font>font32_title</font>
					<label>$INFO[Window(home).Property(InfoViewer_Header)]</label>
					<aligny>center</aligny>
					<shadowcolor>black</shadowcolor>
				</control>
				<control type="button" id="22002">
					<description>button overlay to avoid closing in dialog area</description>
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<texturefocus/>
					<texturenofocus/>
					<onclick>noop</onclick>
				</control>
				<control type="radiobutton">
					<right>10</right>
					<top>11</top>
					<width>48</width>
					<height>48</height>
					<radiowidth>48</radiowidth>
					<radioheight>48</radioheight>
					<texturefocus/>
					<texturenofocus/>
					<label/>
					<textureradioofffocus colordiffuse="EEFFFFFF">dialogs/close.png</textureradioofffocus>
					<textureradiooffnofocus colordiffuse="EEFFFFFF">special://xbmc/media/vendor_icon.png</textureradiooffnofocus>
					<textureradioonfocus colordiffuse="EEFFFFFF">dialogs/close.png</textureradioonfocus>
					<textureradioonnofocus colordiffuse="EEFFFFFF">special://xbmc/media/vendor_icon.png</textureradioonnofocus>
					<onclick>ClearProperty(InfoViewer_Visible,Home)</onclick>
					<visible>!Skin.HasSetting(touchmode)</visible>
				</control>
				<control type="button">
					<right>10</right>
					<top>11</top>
					<width>48</width>
					<height>48</height>
					<texturefocus>dialogs/close.png</texturefocus>
					<texturenofocus>dialogs/close.png</texturenofocus>
					<onclick>ClearProperty(InfoViewer_Visible,Home)</onclick>
					<visible>Skin.HasSetting(touchmode)</visible>
				</control>
			</control>
			<control type="group" id="2000">
				<visible>String.IsEqual(window(home).Property(InfoViewer_Content),MediaDetails)</visible>
				<left>20</left><top>90</top><width>1368</width><height>536</height>
				<control type="button" id="102">
					<left>0</left><top>0</top><width>1340</width><height>532</height>
					<texturefocus /><texturenofocus />
					<onclick>noop</onclick>
					<onfocus>PageUp(2002)</onfocus>
					<onfocus>PageUp(2002)</onfocus>
					<onfocus>PageUp(2002)</onfocus>
					<onfocus>PageUp(2002)</onfocus>
					<onfocus>PageUp(2002)</onfocus>
					<onfocus>PageUp(2002)</onfocus>
					<onleft>102</onleft><onright>102</onright>
					<onup>PageUp(2002)</onup>
					<ondown>PageDown(2002)</ondown>
					<onback>ClearProperty(InfoViewer_Visible,Home)</onback>
					<onback>5000</onback>
				</control>
				<!-- VIDEO: title (left) + badges (right) on one line -->
				<control type="grouplist">
					<left>0</left><top>0</top><width>1320</width><height>44</height>
					<orientation>horizontal</orientation><itemgap>10</itemgap><align>right</align><usecontrolcoords>true</usecontrolcoords>
					<include content="InfoBadge">
						<param name="label" value="$INFO[ListItem.Duration(h:mm:ss)]" />
						<param name="visible" value="!String.IsEmpty(ListItem.Duration)" />
					</include>
					<include content="InfoBadge">
						<param name="label" value="$VAR[VideoCodecVar]" />
						<param name="visible" value="!String.IsEmpty(ListItem.VideoCodec)" />
					</include>
					<include content="InfoBadge">
						<param name="label" value="$INFO[ListItem.VideoResolution]$VAR[VideoResolutionTypeVar, ]" />
						<param name="visible" value="!String.IsEmpty(ListItem.VideoResolution)" />
					</include>
					<include content="InfoBadge">
						<param name="label" value="$VAR[VideoHDRType1Var]$VAR[VideoHDRType2Var, &#8226; ]" />
						<param name="visible" value="!String.IsEmpty(ListItem.HdrType)" />
					</include>
					<include content="InfoBadge">
						<param name="label" value="$INFO[ListItem.VideoAspect,,:1]" />
						<param name="visible" value="!String.IsEmpty(ListItem.VideoAspect)" />
					</include>
				</control>
				<control type="image">
					<left>0</left><top>52</top><width>1320</width><height>2</height>
					<texture colordiffuse="33FFFFFF">colors/white.png</texture>
				</control>
				<!-- AUDIO (left column) -->
				<control type="label">
					<left>0</left><top>60</top><width>640</width><height>40</height><font>font14</font><textcolor>white</textcolor><aligny>bottom</aligny>
					<label>[UPPERCASE]$LOCALIZE[292][/UPPERCASE]</label><visible>!String.IsEmpty(Window(Home).Property(MediaInfo.Audio.1.Codec))</visible>
				</control>
				<control type="grouplist" id="2001">
					<left>0</left><top>108</top><width>640</width><height>412</height>
					<orientation>vertical</orientation><itemgap>6</itemgap>
					<pagecontrol>2002</pagecontrol><scrolltime>200</scrolltime>
						<include content="MediaInfoAudioRow"><param name="n" value="1" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="2" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="3" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="4" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="5" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="6" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="7" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="8" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="9" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="10" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="11" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="12" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="13" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="14" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="15" /></include>
						<include content="MediaInfoAudioRow"><param name="n" value="16" /></include>
				</control>
				<control type="scrollbar" id="2002">
					<left>648</left><top>108</top><width>8</width><height>412</height>
					<orientation>vertical</orientation><onleft>102</onleft><onright>102</onright>
				</control>
				<!-- SUBTITLES (right column) -->
				<control type="label">
					<left>690</left><top>60</top><width>630</width><height>40</height><font>font14</font><textcolor>white</textcolor><aligny>bottom</aligny>
					<label>[UPPERCASE]$LOCALIZE[287][/UPPERCASE]</label><visible>!String.IsEmpty(Window(Home).Property(MediaInfo.Subtitles))</visible>
				</control>
				<control type="textbox">
					<left>690</left><top>108</top><width>630</width><height>410</height><font>font12</font><textcolor>white</textcolor>
					<label>$INFO[Window(Home).Property(MediaInfo.Subtitles)]</label>
				</control>
			</control>
		</control>
	</include>
	<include name="MediaInfoAudioRow">
		<definition>
			<control type="grouplist">
				<height>40</height><width>600</width>
				<orientation>horizontal</orientation><itemgap>12</itemgap><align>left</align><usecontrolcoords>true</usecontrolcoords>
				<visible>!String.IsEmpty(Window(Home).Property(MediaInfo.Audio.$PARAM[n].Codec))</visible>
				<control type="label">
					<width>26</width><height>40</height><font>font10</font><textcolor>grey</textcolor><align>center</align><aligny>center</aligny>
					<label>$NUMBER[$PARAM[n]]</label>
				</control>
				<control type="label">
					<width>auto</width><height>40</height><font>font13</font><textcolor>white</textcolor><aligny>center</aligny>
					<label>$INFO[Window(Home).Property(MediaInfo.Audio.$PARAM[n].Language)]</label>
				</control>
				<include content="InfoBadge">
					<param name="label" value="$INFO[Window(Home).Property(MediaInfo.Audio.$PARAM[n].Codec)]$INFO[Window(Home).Property(MediaInfo.Audio.$PARAM[n].Channels), &#8226; ]" />
					<param name="visible" value="!String.IsEmpty(Window(Home).Property(MediaInfo.Audio.$PARAM[n].Codec))" />
				</include>
			</control>
		</definition>
	</include>
	<include name="InfoBadge">
		<param name="visible">true</param>
		<definition>
			<control type="button">
				<width>auto</width>
				<height>40</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>font_flag</font>
				<label>$PARAM[label]</label>
				<texturefocus border="MediaFlagBorder" infill="false" colordiffuse="white">colors/white.png</texturefocus>
				<texturenofocus border="MediaFlagBorder" infill="false" colordiffuse="white">colors/white.png</texturenofocus>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
</includes>

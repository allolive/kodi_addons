<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
  <section id="service.shutter3d.allolive">
    <category id="general" label="30000">
      <group id="1" label="30010">
        <setting id="start_pause" type="number" label="30015" help="30016">
          <level>0</level>
          <default>0</default>
          <constraints><minimum>0</minimum><step>0.1</step><maximum>10</maximum></constraints>
          <control type="slider" format="number"><popup>false</popup></control>
        </setting>
      </group>
      <group id="2" label="30020">
        <setting id="glasses_delay" type="action" label="30030" help="30031">
          <level>0</level>
          <data>RunScript(service.shutter3d.allolive,delay)</data>
          <control type="button" format="action"><close>true</close></control>
        </setting>
        <setting id="lens_board_info" type="action" label="30029" help="30022">
          <level>0</level>
          <dependencies>
            <dependency type="visible"><condition on="property" name="InfoBool">String.IsEqual(Window(Home).Property(service.shutter3d.allolive.kind),board)</condition></dependency>
            <dependency type="enable"><condition on="property" name="InfoBool">false</condition></dependency>
          </dependencies>
          <control type="button" format="action"/>
        </setting>
        <setting id="lens_closed" type="boolean" label="30021" help="30022">
          <level>0</level>
          <default>true</default>
          <dependencies>
            <dependency type="enable"><condition on="property" name="InfoBool">!String.IsEqual(Window(Home).Property(service.shutter3d.allolive.kind),board)</condition></dependency>
          </dependencies>
          <control type="toggle"/>
        </setting>
        <setting id="lens_redraw_manual" type="integer" label="30023" help="30024">
          <level>0</level>
          <default>0</default>
          <constraints>
            <options>
              <option label="30025">0</option>
              <option label="30026">1</option>
            </options>
          </constraints>
          <dependencies>
            <dependency type="visible">
              <and>
                <condition setting="lens_closed">true</condition>
                <condition on="property" name="InfoBool">!String.IsEqual(Window(Home).Property(service.shutter3d.allolive.kind),board)</condition>
              </and>
            </dependency>
          </dependencies>
          <control type="spinner" format="string"/>
        </setting>
        <setting id="lens_redraw_us" type="integer" label="30027" help="30028">
          <level>0</level>
          <default>8000</default>
          <constraints><minimum>0</minimum><step>100</step><maximum>20000</maximum></constraints>
          <dependencies>
            <dependency type="visible">
              <and>
                <condition setting="lens_closed">true</condition>
                <condition setting="lens_redraw_manual">1</condition>
                <condition on="property" name="InfoBool">!String.IsEqual(Window(Home).Property(service.shutter3d.allolive.kind),board)</condition>
              </and>
            </dependency>
          </dependencies>
          <control type="slider" format="integer"><popup>false</popup></control>
        </setting>
      </group>
    </category>
  </section>
</settings>
